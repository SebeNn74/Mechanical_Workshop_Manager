generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

//* CLIENTES
// ============================================
model Client {
  id             Int          @id @default(autoincrement())
  documentType   DocumentType @default(CC)
  documentNumber String
  name           String
  phone          String
  email          String?
  address        String?
  createdAt      DateTime     @default(now())
  vehicles       Vehicle[]

  @@unique([documentType, documentNumber])
  @@index([documentNumber])
  @@index([name])
}

//* VEHÍCULOS
// ============================================
model Vehicle {
  id         Int         @id @default(autoincrement())
  plateType  PlateType   @default(PRIVATE)
  plate      String      @unique
  brand      String
  model      String
  mileage    Int
  createdAt  DateTime    @default(now())
  client     Client      @relation(fields: [clientId], references: [id])
  clientId   Int
  receptions Reception[]

  @@index([clientId])
  @@index([plate])
}

//* PLANTILLAS DE CHECKLIST
// ============================================
model ChecklistTemplate {
  id          Int                     @id @default(autoincrement())
  name        String
  description String?
  vehicleType PlateType?
  items       ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id         Int               @id @default(autoincrement())
  block      String
  item       String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  @@index([templateId])
}

//* RECEPCIONES
// ============================================
model Reception {
  id              Int             @id @default(autoincrement())
  receptionNumber String          @unique
  dateTime        DateTime        @default(now())
  mileageAtEntry  Int
  notes           String?
  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id])
  vehicleId       Int
  budget          Budget?
  checklist       ChecklistItem[]
  repair          Repair?

  @@index([vehicleId])
  @@index([receptionNumber])
  @@index([dateTime])
}

model ChecklistItem {
  id          Int        @id @default(autoincrement())
  block       String
  item        String
  status      ItemStatus @default(NOT_CHECKED)
  notes       String?
  reception   Reception  @relation(fields: [receptionId], references: [id])
  receptionId Int
  photos      Photo[]

  @@index([receptionId])
}

model Photo {
  id              Int           @id @default(autoincrement())
  filename        String
  path            String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  checklistItemId Int

  @@index([checklistItemId])
}

//* PRESUPUESTOS
// ============================================
model Budget {
  id           Int          @id @default(autoincrement())
  budgetNumber String       @unique
  status       BudgetStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  approvedAt   DateTime?
  reception    Reception    @relation(fields: [receptionId], references: [id])
  receptionId  Int          @unique
  items        BudgetItem[]

  @@index([budgetNumber])
  @@index([status])
}

model BudgetItem {
  id             Int         @id @default(autoincrement())
  description    String
  estimatedPrice Int
  budget         Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId       Int
  repairTasks    RepairTask?

  @@index([budgetId])
}

//* REPARACIONES
// ============================================
model Repair {
  id           Int          @id @default(autoincrement())
  repairNumber String       @unique
  startDate    DateTime     @default(now())
  endDate      DateTime?
  notes        String?
  reception    Reception    @relation(fields: [receptionId], references: [id])
  receptionId  Int          @unique
  tasks        RepairTask[]

  @@index([repairNumber])
}

model RepairTask {
  id           Int        @id @default(autoincrement())
  description  String?
  finalPrice   Int
  repair       Repair     @relation(fields: [repairId], references: [id])
  repairId     Int
  budgetItem   BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  budgetItemId Int        @unique

  @@index([repairId])
}

//* ENUMS
// ============================================
enum DocumentType {
  CC
  NIT
}

enum PlateType {
  PRIVATE
  PUBLIC
  MOTORCYCLE
  OTHER
}

enum BudgetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ItemStatus {
  GOOD
  REGULAR
  BAD
  NOT_CHECKED
}
